# LogiPilot AI 2.1: 100% local, sem serviços pagos ou chaves de API.
# NÃO configure provedores externos. Mesmo se um OPENAI_API_KEY antigo estiver no ambiente,
# este projeto não usa nem faz chamadas para a API da OpenAI.
AI_PROVIDER=ollama
RETRIEVAL_MODE=semantic
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Modelo compacto, adequado como opção inicial; pode trocar para qwen2.5:3b
OLLAMA_MODEL=qwen2.5:1.5b
# Multilíngue, adequado aos documentos e perguntas em português
OLLAMA_EMBEDDING_MODEL=nomic-embed-text-v2-moe
# Limiar didático, ajuste após avaliar as consultas reais
SEMANTIC_MIN_SCORE=0.20
# Opcional: EMBEDDINGS_INDEX_PATH=data/embeddings_index.json

# Webhook é opcional e pode realizar envio externo. Mantenha vazio para 100% local.
ALERT_WEBHOOK_URL=
# Versão 3.0 — IA para classificação de ocorrências (fallback automático por regras)
INCIDENT_AI_ENABLED=true
# Envio externo DESATIVADO por padrão. Aprovação no painel será apenas local.
ALLOW_EXTERNAL_WEBHOOK=false
